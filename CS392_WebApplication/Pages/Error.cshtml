@page
@model CS392_WebApplication.Pages.ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="container mt-5 text-center">

    <h1 class="display-4 text-danger fw-bold">Oops!</h1>

    <p class="lead mb-4">
        Something unexpected happened while processing your request.
    </p>

    <div class="alert alert-light border shadow-sm mx-auto" style="max-width: 600px;">
        <p class="mb-1">
            Our team has been notified and is already looking into it.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted mb-0">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorDetails))
    {
        <div class="mx-auto mt-3" style="max-width: 600px;">
            <button class="btn btn-outline-secondary btn-sm" type="button"
                    onclick="document.getElementById('errorDetails').classList.toggle('d-none');">
                See Details
            </button>
            <div id="errorDetails" class="d-none mt-3 text-start">
                <div class="alert alert-danger">
                    <strong>Error:</strong> @Model.ErrorMessage
                </div>
                <pre class="bg-dark text-light p-3 rounded small" style="white-space: pre-wrap; word-break: break-word;">@Model.ErrorDetails</pre>
            </div>
        </div>
    }

    <a href="/" class="btn btn-primary mt-4 px-4">
        Return to Home
    </a>

</div>
