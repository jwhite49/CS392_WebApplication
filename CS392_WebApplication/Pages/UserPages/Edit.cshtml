@page
@model CS392_WebApplication.Pages.UserPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>
<h4>User</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="User.UserID" />

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="User.Username" class="control-label"></label>
                <input asp-for="User.Username" class="form-control" aria-required="true" />
                <span asp-validation-for="User.Username" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="User.Email" class="control-label"></label>
                <input asp-for="User.Email" class="form-control" aria-required="true" />
                <span asp-validation-for="User.Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="User.Password" class="control-label"></label>
                <input asp-for="User.Password" class="form-control" aria-required="true" />
                <span asp-validation-for="User.Password" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="User.FirstName" class="control-label"></label>
                <input asp-for="User.FirstName" class="form-control" aria-required="true" />
                <span asp-validation-for="User.FirstName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="User.LastName" class="control-label"></label>
                <input asp-for="User.LastName" class="form-control" aria-required="true" />
                <span asp-validation-for="User.LastName" class="text-danger"></span>
            </div>

            @* ✅ Role assignment section *@
            <div class="form-group mb-3">
                <label class="control-label">
                    <strong>Assign Role</strong>
                    @if (!string.IsNullOrEmpty(Model.CurrentRole))
                    {
                        <span class="text-muted ms-2">(Current: @Model.CurrentRole)</span>
                    }
                </label>
                <select name="SelectedRole" class="form-control">
                    <option value="">-- Select a Role --</option>
                    @foreach (var role in Model.AvailableRoles)
                    {
                        if (role == Model.SelectedRole)
                        {
                            <option value="@role" selected>@role</option>
                        }
                        else
                        {
                            <option value="@role">@role</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}