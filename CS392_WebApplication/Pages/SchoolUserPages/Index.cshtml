@page
@model CS392_WebApplication.Pages.SchoolUserPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.School_User[0].school_name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.School_User[0].is_approved)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.School_User) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.school_name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.is_approved)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.userID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.userID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.userID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
