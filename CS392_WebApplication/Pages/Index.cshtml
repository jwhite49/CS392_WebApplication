@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">

    <!-- Top Banner -->
    <img src="/images/TopBanner.png" class="banner mb-4" />

    <!-- Main Action Buttons -->
    <div class="text-center mb-4">
        <button class="home-action-btn" onclick="window.location.href='/ProductPages/Catalog/Index'">
            Browse Catalog
        </button>

        <button class="home-action-btn" onclick="window.location.href='/Lists/CreateList'">
            Create My List
        </button>
        <button class="home-action-btn" onclick="window.location.href='/Lists/BrowsePublished'">
            Browse Lists
        </button>
    </div>

    

    <!-- Featured Categories -->
    <h4 class="home-section-title">Featured Categories</h4>

    <div class="d-flex flex-wrap justify-content-center gap-3">

        <button class="category-btn" onclick="window.location.href='/ProductPages/Catalog/Index?Search=Notebook'">
            <img src="/images/notebook.png" />
            <p>Notebooks</p>
        </button>

        <button class="category-btn" onclick="window.location.href='/ProductPages/Catalog/Index?Search=Pen Pencil Marker'">
            <img src="/images/pencil.png" />
            <p>Writing</p>
        </button>

        <button class="category-btn" onclick="window.location.href='/ProductPages/Catalog/Index?Search=Technology'">
            <img src="/images/calculator.png" />
            <p>Tech</p>
        </button>

        <button class="category-btn" onclick="window.location.href='/ProductPages/Catalog/Index?Search=Backpack'">
            <img src="/images/backpack.png" />
            <p>Backpacks</p>
        </button>

        <button class="category-btn" onclick="window.location.href='/ProductPages/Catalog/Index?Search=Bottle'">
            <img src="/images/bottle.png" />
            <p>Bottles</p>
        </button>

    </div>
    <!-- How It Works -->
    <h4 class="home-section-title">How School-ify Works</h4>

    <div class="d-flex flex-wrap justify-content-center gap-4 text-center">

        <div class="hiw-card">
            <img src="/images/browse.png" />
            <p><strong>1. Browse Supplies</strong></p>
            <p>Explore thousands of school essentials.</p>
        </div>

        <div class="hiw-card">
            <img src="/images/list.png" />
            <p><strong>2. Build Your List</strong></p>
            <p>Create custom lists for any grade.</p>
        </div>

        <div class="hiw-card">
            <img src="/images/shop.png" />
            <p><strong>3. Shop Smarter</strong></p>
            <p>Compare prices and buy instantly.</p>
        </div>

    </div>

    @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
    {
        <hr class="my-4" />
        <h4 class="home-section-title">Teacher Account</h4>

        @if (Model.IsAlreadySchool)
        {
            <div class="text-center">
                <p class="text-success fw-bold">You have an approved teacher account.</p>
            </div>
        }
        else if (Model.HasExistingRequest)
        {
            <div class="text-center">
                <p class="text-warning fw-bold">Your teacher account request is pending admin approval.</p>
            </div>
        }
        else
        {
            <div class="text-center">
                <p>Are you a teacher? Sign up for a teacher account to create and share school supply lists with your students.</p>
                <button class="home-action-btn" onclick="window.location.href='/TeacherRequest'">
                    Request Teacher Account
                </button>
            </div>
        }
    }
</div>
