<style>
    table, th, td {
        border: 1px solid black;
    }
    table{
        width:100%;
        height:100%;
    }
    .banner{
        width: 100%;
    }
   
    .popularButtons p{
        display: inline;
        color: red;
    }
    .popularButtons button{
        cursor: pointer;
        display: inline-block;
        border: none;
        background-color: none;
        border-radius:10px;
    }

    .middleButtons p {
        display: inline;
        color: red;
        text-align: center;
        padding:10px;
    }
    .middleButtons button {
        cursor: pointer;
        border: none;
        border-radius: 10px;
    }
   
    .popularButtons img{
        height:120px;
    }
    .middleButtons, .popularButtons {
        text-align: center;
        justify-content: space-around;
        padding:5px 10px 5px 10px;
    }

    button:hover {
        transform: scale(1.1);
        transition: transform 0.3s;
    }
</style>
<div class="container mt-4">
    <img src="/images/TopBanner.png" class="banner mb-4" />

    <div class="middleButtons mb-3 text-center">
        <button type="button"><p>Create a list</p></button>
        <button type="button"><p>Shop by:</p></button>
        <button type="button"><p>Bundles</p></button>
    </div>

    <h4 class="text-center">Popular Items</h4>

    <div class="popularButtons d-flex flex-wrap justify-content-center gap-3">
        <button type="button">
            <img src="/images/calculator.png" />
            <p>Calculator</p>
        </button>
        <button type="button">
            <img src="/images/notebook.png" />
            <p>Notebooks</p>
        </button>
        <button type="button">
            <img src="/images/pencil.png" />
            <p>Pencils</p>
        </button>
        <button type="button">
            <img src="/images/backpack.png" />
            <p>Backpacks</p>
        </button>
        <button type="button">
            <img src="/images/bottle.png" />
            <p>Bottles</p>
        </button>
    </div>
</div>