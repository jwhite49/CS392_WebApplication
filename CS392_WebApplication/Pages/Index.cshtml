<!--Login "Modal"-->
<div id="loginModal">
    <div id="loginModal-container">
    <span onclick="closeModal()" class="closeLogin">X</span>
    <form method="post" asp-page="/Pages/LoginModel">
        <label for="Username">Username</label>
        <input type="text" asp-for="Username" required/>
        <!--"asp-for" connects textfield to model in Index.cshtml.cs -->
        <label for="Password">Password</label>
        <input type="password" asp-for="Password" required />
        <br />
        <input type="submit" value="Sign In"/>
    </form>
    </div>
</div>


