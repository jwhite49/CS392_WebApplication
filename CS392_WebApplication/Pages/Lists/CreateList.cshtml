@page
@model CS392_WebApplication.Pages.Lists.CreateListModel
@{
    ViewData["Title"] = "Create New List";
}

<h2>Create New List</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">List Title</label>
                <input asp-for="Title" class="form-control" placeholder="e.g. 3rd Grade School Supplies" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description (optional)</label>
                <textarea asp-for="Description" class="form-control" rows="3"
                          placeholder="Describe what this list is for..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GradeLevel" class="form-label">Grade Level (optional)</label>
                <input asp-for="GradeLevel" class="form-control" placeholder="e.g. 3rd Grade" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create List</button>
                <a class="btn btn-outline-secondary" asp-page="/Lists/List">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}