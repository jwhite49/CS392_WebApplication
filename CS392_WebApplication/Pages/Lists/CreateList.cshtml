@page
@model CS392_WebApplication.Pages.Lists.CreateListModel
@{
    ViewData["Title"] = "Create New List";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="bi bi-list-ul me-2"></i>Create Your List</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <!-- Step 1: Basic Info -->
                        <div class="mb-4">
                            <h5 class="text-muted mb-3">Basic Information</h5>
                            
                            <div class="mb-3">
                                <label asp-for="Title" class="form-label fw-bold">List Title *</label>
                                <input asp-for="Title" class="form-control" placeholder="e.g., My College Dorm List" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-bold">Description (Optional)</label>
                                <textarea asp-for="Description" class="form-control" rows="3" 
                                          placeholder="Add any notes about this list..."></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Step 2: Budget (Optional) -->
                        <div class="mb-4">
                            <h5 class="text-muted mb-3">Budget (Optional)</h5>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-info-circle me-1"></i>
                                Setting a budget helps you track spending and get relevant recommendations
                            </p>
                            
                            <div class="mb-3">
                                <label asp-for="BudgetAmount" class="form-label fw-bold">Budget Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="BudgetAmount" type="number" step="0.01" class="form-control" 
                                           placeholder="0.00" />
                                </div>
                                <span asp-validation-for="BudgetAmount" class="text-danger"></span>
                                <small class="form-text text-muted">Leave blank if you don't want to set a budget</small>
                            </div>
                        </div>

                        <!-- Step 3: Category (Optional) -->
                        <div class="mb-4">
                            <h5 class="text-muted mb-3">List Category (Optional)</h5>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-info-circle me-1"></i>
                                Helps us recommend popular items for your specific needs
                            </p>
                            
                            <div class="mb-3">
                                <label asp-for="ListCategory" class="form-label fw-bold">What's this list for?</label>
                                <select asp-for="ListCategory" class="form-select">
                                    <option value="">-- Select a category (optional) --</option>
                                    @foreach (var category in Model.CategoryOptions)
                                    {
                                        <option value="@category">@category</option>
                                    }
                                </select>
                                <span asp-validation-for="ListCategory" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle me-2"></i>Create List
                            </button>
                            <a asp-page="/Lists/List" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}