@page "{listId:int}"
@model CS392_WebApplication.Pages.Lists.ListDetailsModel
@{
    ViewData["Title"] = Model.UserList.title ?? "List Details";
}

<div class="container mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>
                @if (Model.IsImportedList)
                {
                    <i class="bi bi-download me-2 text-info"></i>
                }
                @(Model.UserList.title ?? "Untitled List")
            </h2>
            @if (!string.IsNullOrEmpty(Model.UserList.description))
            {
                <p class="text-muted">@Model.UserList.description</p>
            }
            @if (Model.IsImportedList)
            {
                <span class="badge bg-info">Imported List</span>
            }
        </div>
        <a class="btn btn-outline-secondary" asp-page="/Lists/List">
            <i class="bi bi-arrow-left me-2"></i>Back to My Lists
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Progress Tracking for Imported Lists -->
    @if (Model.ShowProgressTracking && Model.ListItems.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-check-circle me-2"></i>Your Progress
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="fw-bold">Completion</span>
                                        <span class="fw-bold">@Model.PurchasedItemsCount / @Model.TotalItemsCount items</span>
                                    </div>
                                    <div class="progress" style="height: 30px;">
                                        <div class="progress-bar bg-success" role="progressbar" 
                                             style="width: @((Model.PurchasedItemsCount * 100.0 / Model.TotalItemsCount))%">
                                            @((Model.PurchasedItemsCount * 100.0 / Model.TotalItemsCount).ToString("N0"))%
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded text-center">
                                            <small class="text-muted d-block">Already Purchased</small>
                                            <h5 class="mb-0 text-success">$@Model.TotalSpent.ToString("N2")</h5>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-3 bg-light rounded text-center">
                                            <small class="text-muted d-block">Still Needed</small>
                                            <h5 class="mb-0 text-primary">$@Model.RemainingToBuy.ToString("N2")</h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Budget Dashboard (Only for non-imported user lists) -->
    @if (Model.ShowBudgetFeatures)
    {
        <div class="row mb-4">
            <!-- Budget Summary Card -->
            <div class="col-lg-8 mb-3">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-piggy-bank me-2"></i>Budget Overview
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (Model.UserList.budget_amount.HasValue)
                        {
                            var budgetPercent = Model.UserList.BudgetUtilizationPercent ?? 0;
                            var budgetRemaining = Model.UserList.BudgetRemaining ?? 0;
                            var progressClass = budgetPercent >= 100 ? "bg-danger" : budgetPercent >= 90 ? "bg-warning" : "bg-success";
                            var statusClass = budgetPercent >= 100 ? "danger" : budgetPercent >= 90 ? "warning" : "success";
                            var statusIcon = budgetPercent >= 100 ? "exclamation-triangle" : budgetPercent >= 90 ? "exclamation-circle" : "check-circle";
                            var statusText = budgetPercent >= 100 ? "Over Budget" : budgetPercent >= 90 ? "Near Budget Limit" : "Under Budget";

                            <!-- Budget Status Badge -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="mb-0">Budget: $@Model.UserList.budget_amount.Value.ToString("N2")</h4>
                                <span class="badge bg-@statusClass fs-6">
                                    <i class="bi bi-@statusIcon me-1"></i>@statusText
                                </span>
                            </div>

                            <!-- Progress Bar -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Budget Utilization</span>
                                    <span class="fw-bold">@budgetPercent.ToString("N1")%</span>
                                </div>
                                <div class="progress" style="height: 25px;">
                                    <div class="progress-bar @progressClass" role="progressbar" 
                                         style="width: @Math.Min(budgetPercent, 100)%" 
                                         aria-valuenow="@budgetPercent" aria-valuemin="0" aria-valuemax="100">
                                        $@Model.UserList.total_price.ToString("N2")
                                    </div>
                                </div>
                            </div>

                            <!-- Budget Breakdown -->
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded">
                                        <small class="text-muted d-block">Total List Value</small>
                                        <h5 class="mb-0">$@Model.UserList.total_price.ToString("N2")</h5>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded">
                                        <small class="text-muted d-block">Already Purchased</small>
                                        <h5 class="mb-0 text-success">$@Model.TotalSpent.ToString("N2")</h5>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded">
                                        <small class="text-muted d-block">
                                            @if (budgetRemaining >= 0)
                                            {
                                                <span>Budget Remaining</span>
                                            }
                                            else
                                            {
                                                <span>Over Budget By</span>
                                            }
                                        </small>
                                        <h5 class="mb-0 text-@statusClass">$@Math.Abs(budgetRemaining).ToString("N2")</h5>
                                    </div>
                                </div>
                            </div>

                            <!-- Edit Budget Button -->
                            <div class="mt-3">
                                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editBudgetModal">
                                    <i class="bi bi-pencil me-1"></i>Edit Budget & Category
                                </button>
                            </div>
                        }
                        else
                        {
                            <!-- No Budget Set -->
                            <div class="text-center py-4">
                                <i class="bi bi-piggy-bank display-4 text-muted"></i>
                                <h5 class="mt-3 text-muted">No Budget Set</h5>
                                <p class="text-muted mb-3">Set a budget to track your spending and get recommendations</p>
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editBudgetModal">
                                    <i class="bi bi-plus-circle me-2"></i>Set Budget
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Quick Stats Card -->
            <div class="col-lg-4 mb-3">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-graph-up me-2"></i>Statistics
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (Model.ListItems.Any())
                        {
                            <!-- Completion Progress -->
                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">Items Purchased</small>
                                <div class="d-flex align-items-center">
                                    <h4 class="mb-0 me-2">@Model.PurchasedItemsCount / @Model.TotalItemsCount</h4>
                                    <small class="text-muted">(@((Model.PurchasedItemsCount * 100.0 / Model.TotalItemsCount).ToString("N0"))%)</small>
                                </div>
                                <div class="progress mt-2" style="height: 8px;">
                                    <div class="progress-bar bg-success" role="progressbar" 
                                         style="width: @((Model.PurchasedItemsCount * 100.0 / Model.TotalItemsCount))%"></div>
                                </div>
                            </div>

                            <hr>

                            <!-- Price Stats -->
                            <div class="mb-3">
                                <small class="text-muted d-block">Average Item Price</small>
                                <h5 class="mb-0">$@Model.AverageItemPrice.ToString("N2")</h5>
                            </div>

                            <div class="mb-3">
                                <small class="text-muted d-block">Most Expensive Item</small>
                                <h5 class="mb-0">$@Model.MostExpensiveItemPrice.ToString("N2")</h5>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.UserList.list_category))
                            {
                                <div class="mb-3">
                                    <small class="text-muted d-block">Category</small>
                                    <span class="badge bg-info">@Model.UserList.list_category</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <i class="bi bi-inbox display-4 text-muted"></i>
                                <p class="text-muted mt-2 mb-0">No items yet</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Budget Visualization Chart -->
        @if (Model.UserList.budget_amount.HasValue && Model.ListItems.Any())
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="bi bi-pie-chart me-2"></i>Budget Breakdown
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <canvas id="budgetChart" style="max-height: 300px;"></canvas>
                                </div>
                                <div class="col-md-6 d-flex align-items-center">
                                    <div class="w-100">
                                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                            <div class="d-flex align-items-center">
                                                <div style="width: 20px; height: 20px; background-color: #28a745; border-radius: 3px;" class="me-2"></div>
                                                <span>Already Purchased</span>
                                            </div>
                                            <strong>$@Model.TotalSpent.ToString("N2")</strong>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                            <div class="d-flex align-items-center">
                                                <div style="width: 20px; height: 20px; background-color: #007bff; border-radius: 3px;" class="me-2"></div>
                                                <span>Remaining to Buy</span>
                                            </div>
                                            <strong>$@Model.RemainingToBuy.ToString("N2")</strong>
                                        </div>
                                        @if (Model.UserList.BudgetRemaining.HasValue && Model.UserList.BudgetRemaining.Value > 0)
                                        {
                                            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                                <div class="d-flex align-items-center">
                                                    <div style="width: 20px; height: 20px; background-color: #e9ecef; border-radius: 3px;" class="me-2"></div>
                                                    <span>Budget Remaining</span>
                                                </div>
                                                <strong>$@Model.UserList.BudgetRemaining.Value.ToString("N2")</strong>
                                            </div>
                                        }
                                        else if (Model.UserList.BudgetRemaining.HasValue && Model.UserList.BudgetRemaining.Value < 0)
                                        {
                                            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                                <div class="d-flex align-items-center">
                                                    <div style="width: 20px; height: 20px; background-color: #dc3545; border-radius: 3px;" class="me-2"></div>
                                                    <span>Over Budget</span>
                                                </div>
                                                <strong class="text-danger">$@Math.Abs(Model.UserList.BudgetRemaining.Value).ToString("N2")</strong>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- List Items -->
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-cart me-2"></i>Items (@Model.ListItems.Count)
                </h5>
                @if (Model.CanModifyList)
                {
                    <a asp-page="/ProductPages/Catalog/Index" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Add Items
                    </a>
                }
            </div>
        </div>
        <div class="card-body">
            @if (!Model.ListItems.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">No items in this list</h4>
                    @if (Model.CanModifyList)
                    {
                        <p class="text-muted">Start adding products to your list</p>
                        <a asp-page="/ProductPages/Catalog/Index" class="btn btn-primary mt-2">
                            <i class="bi bi-search me-2"></i>Browse Products
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th style="width: 50px;"></th>
                                <th>Product</th>
                                <th class="text-center" style="width: 100px;">Quantity</th>
                                <th class="text-end" style="width: 120px;">Price</th>
                                <th class="text-end" style="width: 120px;">Subtotal</th>
                                @if (Model.CanModifyList)
                                {
                                    <th class="text-center" style="width: 100px;">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (item, product) in Model.ListItems)
                            {
                                var subtotal = product.retail_price * item.quantity;
                                <tr class="@(item.is_purchased ? "table-success" : "")">
                                    <td>
                                        <form method="post" asp-page-handler="TogglePurchased" asp-route-listId="@Model.UserList.listID" asp-route-itemId="@item.list_items_ID">
                                            <button type="submit" class="btn btn-sm @(item.is_purchased ? "btn-success" : "btn-outline-secondary")" 
                                                    title="@(item.is_purchased ? "Mark as not purchased" : "Mark as purchased")">
                                                <i class="bi bi-@(item.is_purchased ? "check-circle-fill" : "circle")"></i>
                                            </form>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(product.ImageURL))
                                                {
                                                    <img src="@product.ImageURL" alt="@product.product_name" 
                                                         class="me-3 rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                                }
                                                <div>
                                                    <div class="fw-bold">@product.product_name</div>
                                                    @if (!string.IsNullOrEmpty(product.source_name))
                                                    {
                                                        <small class="text-muted">@product.source_name</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary">@item.quantity</span>
                                        </td>
                                        <td class="text-end">
                                            $@product.retail_price.ToString("N2")
                                        </td>
                                        <td class="text-end fw-bold">
                                            $@subtotal.ToString("N2")
                                        </td>
                                        @if (Model.CanModifyList)
                                        {
                                            <td class="text-center">
                                                <form method="post" asp-page-handler="RemoveItem" asp-route-listId="@Model.UserList.listID" asp-route-itemId="@item.list_items_ID"
                                                      onsubmit="return confirm('Remove this item from your list?');" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove from list">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                            }
                        }
                        </tbody>
                        <tfoot>
                            <tr class="table-light fw-bold">
                                <td colspan="@(Model.CanModifyList ? 4 : 4)" class="text-end">Total:</td>
                                <td class="text-end fs-5">$@Model.UserList.total_price.ToString("N2")</td>
                                @if (Model.CanModifyList)
                                {
                                    <td></td>
                                }
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit Budget Modal -->
@if (Model.ShowBudgetFeatures)
{
    <div class="modal fade" id="editBudgetModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="UpdateBudget" asp-route-listId="@Model.UserList.listID">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Budget & Category</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label asp-for="EditBudgetAmount" class="form-label fw-bold">Budget Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="EditBudgetAmount" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="EditBudgetAmount" class="text-danger"></span>
                            <small class="form-text text-muted">Leave blank to remove budget tracking</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EditListCategory" class="form-label fw-bold">List Category</label>
                            <select asp-for="EditListCategory" class="form-select">
                                <option value="">-- No Category --</option>
                                @foreach (var category in Model.CategoryOptions)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                            <span asp-validation-for="EditListCategory" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    @if (Model.ShowBudgetFeatures && Model.UserList.budget_amount.HasValue && Model.ListItems.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script>
            const ctx = document.getElementById('budgetChart');
            
            const budgetRemaining = @(Model.UserList.BudgetRemaining ?? 0);
            const isOverBudget = budgetRemaining < 0;
            
            const chartData = {
                labels: isOverBudget 
                    ? ['Already Purchased', 'Remaining to Buy', 'Over Budget']
                    : ['Already Purchased', 'Remaining to Buy', 'Budget Remaining'],
                datasets: [{
                    data: isOverBudget
                        ? [@Model.TotalSpent, @Model.RemainingToBuy, @Math.Abs(Model.UserList.BudgetRemaining ?? 0)]
                        : [@Model.TotalSpent, @Model.RemainingToBuy, @(Model.UserList.BudgetRemaining ?? 0)],
                    backgroundColor: isOverBudget
                        ? ['#28a745', '#007bff', '#dc3545']
                        : ['#28a745', '#007bff', '#e9ecef'],
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            };

            new Chart(ctx, {
                type: 'doughnut',
                data: chartData,
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 15,
                                font: {
                                    size: 12
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    label += '$' + context.parsed.toFixed(2);
                                    return label;
                                }
                            }
                        }
                    }
                }
            });
        </script>
    }
}