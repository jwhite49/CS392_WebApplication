@page
@model CS392_WebApplication.Pages.Lists.ListModel
@{
    ViewData["Title"] = "My Lists";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-list-ul me-2"></i>My Lists</h2>
        <a asp-page="/Lists/CreateList" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Create New List
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.UserLists.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No lists yet</h4>
            <p class="text-muted">Create your first list or browse published lists from teachers</p>
            <div class="mt-3">
                <a asp-page="/Lists/CreateList" class="btn btn-primary me-2">
                    <i class="bi bi-plus-circle me-2"></i>Create List
                </a>
                <a asp-page="/Lists/BrowsePublished" class="btn btn-outline-primary">
                    <i class="bi bi-search me-2"></i>Browse Published Lists
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var list in Model.UserLists)
            {
                var isImported = Model.ImportedListIds.Contains(list.listID);
                var itemCount = Model.ListItemCounts.GetValueOrDefault(list.listID, 0);

                <div class="col">
                    <div class="card h-100 shadow-sm">
                        @if (isImported)
                        {
                            <div class="card-header bg-info text-white">
                                <i class="bi bi-download me-2"></i>Imported List
                            </div>
                        }
                        else if (list.budget_amount.HasValue)
                        {
                            var budgetPercent = list.BudgetUtilizationPercent ?? 0;
                            var badgeClass = budgetPercent >= 100 ? "bg-danger" : budgetPercent >= 90 ? "bg-warning" : "bg-success";
                            
                            <div class="card-header @badgeClass text-white">
                                <i class="bi bi-piggy-bank me-2"></i>Budget: $@list.budget_amount.Value.ToString("N2")
                            </div>
                        }

                        <div class="card-body">
                            <h5 class="card-title">@list.title</h5>
                            @if (!string.IsNullOrEmpty(list.description))
                            {
                                <p class="card-text text-muted small">@list.description</p>
                            }
                            @if (!string.IsNullOrEmpty(list.list_category))
                            {
                                <p class="mb-2">
                                    <span class="badge bg-secondary">@list.list_category</span>
                                </p>
                            }
                            <p class="mb-2">
                                <strong>Items:</strong> @itemCount | 
                                <strong>Total:</strong> $@list.total_price.ToString("N2")
                            </p>

                            @if (isImported && Model.ImportedListProgress.ContainsKey(list.listID))
                            {
                                var progress = Model.ImportedListProgress[list.listID];
                                var percentComplete = progress.TotalItems > 0 
                                    ? (int)((progress.CompletedItems / (double)progress.TotalItems) * 100) 
                                    : 0;
                                
                                <div class="mb-2">
                                    <small class="text-muted">Progress: @progress.CompletedItems / @progress.TotalItems</small>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-success" role="progressbar" 
                                             style="width: @percentComplete%"></div>
                                    </div>
                                </div>
                            }

                            @if (!isImported && list.budget_amount.HasValue)
                            {
                                var budgetRemaining = list.BudgetRemaining ?? 0;
                                var budgetPercent = list.BudgetUtilizationPercent ?? 0;
                                var progressClass = budgetPercent >= 100 ? "bg-danger" : budgetPercent >= 90 ? "bg-warning" : "bg-success";
                                
                                <div class="mb-2">
                                    <small class="text-muted">
                                        @if (budgetRemaining >= 0)
                                        {
                                            <span>Remaining: $@budgetRemaining.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">Over by: $@Math.Abs(budgetRemaining).ToString("N2")</span>
                                        }
                                    </small>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar @progressClass" role="progressbar" 
                                             style="width: @Math.Min(budgetPercent, 100)%"></div>
                                    </div>
                                </div>
                            }

                            <small class="text-muted">Updated: @list.updated_at.ToLocalTime().ToString("MMM dd, yyyy")</small>
                        </div>

                        <div class="card-footer bg-transparent">
                            <div class="d-flex gap-2">
                                <a asp-page="/Lists/ListDetails" asp-route-listId="@list.listID" 
                                   class="btn btn-sm btn-primary flex-fill">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                                
                                @if (!isImported && Model.IsAdminOrSchool)
                                {
                                    <a asp-page="/Lists/ManageList" asp-route-listId="@list.listID" 
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-gear me-1"></i>Manage
                                    </a>
                                }

                                <form method="post" asp-page-handler="DeleteList" asp-route-listId="@list.listID" 
                                      class="d-inline" onsubmit="return confirm('Are you sure you want to delete this list?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
