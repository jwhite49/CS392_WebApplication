@page
@model CS392_WebApplication.Pages.Lists.ListModel
@{
    ViewData["Title"] = "My Lists";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Lists</h2>
    <div>
        <a class="btn btn-outline-primary me-2" asp-page="/Lists/BrowsePublished">
            Browse Published Lists
        </a>
        <a class="btn btn-primary" asp-page="/Lists/CreateList">
            + Create New List
        </a>
    </div>
</div>

<!-- SUCCESS / ERROR MESSAGES -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.UserLists.Count == 0)
{
    <div class="alert alert-info">
        <strong>You don't have any lists yet.</strong><br />
        Create your first list or browse published lists to get started!
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var list in Model.UserLists)
        {
            var itemCount = Model.ListItemCounts.GetValueOrDefault(list.listID, 0);
            var isImported = Model.ImportedListIds.Contains(list.listID);

            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm h-100 @(isImported ? "border-info" : "")">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@(list.title ?? "Untitled List")</h5>
                            <div class="d-flex flex-column align-items-end gap-1">
                                @if (list.is_published)
                                {
                                    <span class="badge bg-success">Published</span>
                                }
                                @if (isImported)
                                {
                                    <span class="badge bg-info text-dark">Imported</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Created by you</span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(list.description))
                        {
                            <p class="card-text text-muted small">@list.description</p>
                        }

                        @if (!string.IsNullOrEmpty(list.grade_level))
                        {
                            <p class="mb-1"><small><strong>Grade:</strong> @list.grade_level</small></p>
                        }

                        <p class="mb-1"><strong>Items:</strong> @itemCount</p>
                        <p class="mb-1"><strong>Total:</strong> $@list.total_price.ToString("0.00")</p>
                        <p class="text-muted small mb-2">
                            Updated: @list.updated_at.ToShortDateString()
                        </p>

                        <div class="mt-auto d-flex flex-wrap gap-2">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-page="/Lists/ListDetails"
                               asp-route-listId="@list.listID">
                                View
                            </a>

                            @if (Model.IsAdminOrSchool && list.list_type == CS392_WebApplication.Models.ListType.School)
                            {
                                <a class="btn btn-sm btn-outline-info"
                                   asp-page="/Lists/ManageList"
                                   asp-route-listId="@list.listID">
                                    Manage
                                </a>
                            }

                            <form method="post" asp-page-handler="DeleteList" class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this list?');">
                                <input type="hidden" name="listId" value="@list.listID" />
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
