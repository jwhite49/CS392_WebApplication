@page
@model CS392_WebApplication.Pages.Lists.BrowsePublishedModel
@{
    ViewData["Title"] = "Browse Published Lists";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Browse Published Lists</h2>
    <a class="btn btn-outline-secondary" asp-page="/Lists/List">&larr; Back to My Lists</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (Model.PublishedLists.Count == 0)
{
    <div class="alert alert-info">
        No published lists are available right now. Check back later!
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var entry in Model.PublishedLists)
        {
            var list = entry.List;
            var alreadyAdded = Model.AlreadyAddedListIds.Contains(list.listID);

            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@(list.title ?? "Untitled List")</h5>

                        @if (!string.IsNullOrEmpty(list.description))
                        {
                            <p class="card-text text-muted small">@list.description</p>
                        }

                        <p class="mb-1"><small><strong>By:</strong> @entry.OwnerName</small></p>

                        @if (!string.IsNullOrEmpty(list.grade_level))
                        {
                            <p class="mb-1"><small><strong>Grade:</strong> @list.grade_level</small></p>
                        }

                        <p class="mb-1"><strong>Items:</strong> @entry.ItemCount</p>
                        <p class="mb-1"><strong>Est. Total:</strong> $@list.total_price.ToString("0.00")</p>
                        <p class="text-muted small mb-2">
                            @entry.StudentCount student(s) added this list
                        </p>

                        <div class="mt-auto">
                            @if (alreadyAdded)
                            {
                                <button class="btn btn-sm btn-secondary" disabled>
                                    &#10003; Already Added
                                </button>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="AddToMyLists">
                                    <input type="hidden" name="publishedListId" value="@list.listID" />
                                    <button class="btn btn-sm btn-primary">
                                        + Add to My Lists
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}