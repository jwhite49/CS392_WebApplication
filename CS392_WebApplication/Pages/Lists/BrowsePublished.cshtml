@page
@model CS392_WebApplication.Pages.Lists.BrowsePublishedModel
@{
    ViewData["Title"] = "Browse Published Lists";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Browse Published Lists</h2>
    <a class="btn btn-outline-secondary" asp-page="/Lists/List">&larr; Back to My Lists</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Private Code Entry -->
<div class="card shadow-sm mb-4 bg-light">
    <div class="card-body">
        <h5 class="card-title">Have a Private Code?</h5>
        <p class="text-muted small mb-3">
            If your teacher gave you a private access code, enter it here to import the list.
        </p>
        
        <form method="post" asp-page-handler="ImportByCode" class="row g-2 align-items-end">
            <div class="col-auto">
                <label for="privateCode" class="form-label small mb-1">Private Code</label>
                <input type="text" 
                       name="privateCode" 
                       id="privateCode" 
                       class="form-control text-uppercase" 
                       placeholder="e.g. ABCD1234"
                       maxlength="12"
                       required 
                       style="min-width: 200px;" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Import List</button>
            </div>
        </form>
    </div>
</div>

<!-- Public Lists -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Public Lists</h4>
    <span class="text-muted">Showing @Model.PublishedLists.Count of @Model.TotalCount lists</span>
</div>

@if (Model.PublishedLists.Count == 0)
{
    <div class="alert alert-info">
        No public lists are available right now. Check back later or use a private code!
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var entry in Model.PublishedLists)
        {
            var list = entry.List;
            var alreadyAdded = Model.AlreadyAddedListIds.Contains(list.listID);

            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@(list.title ?? "Untitled List")</h5>
                            <span class="badge bg-success">Public</span>
                        </div>

                        @if (!string.IsNullOrEmpty(list.description))
                        {
                            <p class="card-text text-muted small">@list.description</p>
                        }

                        <p class="mb-1"><small><strong>By:</strong> @entry.OwnerName</small></p>

                        @if (!string.IsNullOrEmpty(list.grade_level))
                        {
                            <p class="mb-1"><small><strong>Grade:</strong> @list.grade_level</small></p>
                        }

                        <p class="mb-1"><strong>Items:</strong> @entry.ItemCount</p>
                        <p class="mb-1"><strong>Est. Total:</strong> $@list.total_price.ToString("0.00")</p>
                        <p class="text-muted small mb-2">
                            @entry.StudentCount student(s) added this list
                        </p>

                        <div class="mt-auto">
                            @if (alreadyAdded)
                            {
                                <button class="btn btn-sm btn-secondary" disabled>
                                    &#10003; Already Added
                                </button>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="AddToMyLists">
                                    <input type="hidden" name="publishedListId" value="@list.listID" />
                                    <button class="btn btn-sm btn-primary">
                                        + Add to My Lists
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination Controls -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <!-- Previous Button -->
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="/Lists/BrowsePublished" asp-route-pageNumber="@(Model.CurrentPage - 1)">
                        Previous
                    </a>
                </li>

                <!-- Page Numbers -->
                @{
                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                    var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                }

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-page="/Lists/BrowsePublished" asp-route-pageNumber="1">1</a>
                    </li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                @for (var i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-page="/Lists/BrowsePublished" asp-route-pageNumber="@i">@i</a>
                    </li>
                }

                @if (endPage < Model.TotalPages)
                {
                    @if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" asp-page="/Lists/BrowsePublished" asp-route-pageNumber="@Model.TotalPages">@Model.TotalPages</a>
                    </li>
                }

                <!-- Next Button -->
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-page="/Lists/BrowsePublished" asp-route-pageNumber="@(Model.CurrentPage + 1)">
                        Next
                    </a>
                </li>
            </ul>
        </nav>
    }
}