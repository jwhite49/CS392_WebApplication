@page
@model CS392_WebApplication.Pages.ProductPages.Catalog.IndexModel

<h2 class="mb-4">Product Catalog</h2>

@* Budget Banner - Shows when shopping for a specific list with budget *@
@if (Model.ShowBudgetFeatures && Model.ContextList != null)
{
    var budgetPercent = Model.ContextList.BudgetUtilizationPercent ?? 0;
    var statusClass = budgetPercent >= 100 ? "danger" : budgetPercent >= 90 ? "warning" : "success";
    var statusIcon = budgetPercent >= 100 ? "exclamation-triangle" : budgetPercent >= 90 ? "exclamation-circle" : "piggy-bank";
    
    <div class="alert alert-@statusClass border-@statusClass mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="alert-heading mb-2">
                    <i class="bi bi-@statusIcon me-2"></i>
                    Shopping for: @Model.ContextList.title
                </h5>
                <div class="d-flex gap-4 flex-wrap">
                    <div>
                        <strong>Budget:</strong> $@Model.ContextList.budget_amount!.Value.ToString("N2")
                    </div>
                    <div>
                        <strong>Current Total:</strong> $@Model.ContextList.total_price.ToString("N2")
                    </div>
                    <div>
                        <strong>Remaining:</strong> 
                        @if (Model.BudgetRemaining >= 0)
                        {
                            <span class="text-success">$@Model.BudgetRemaining.ToString("N2")</span>
                        }
                        else
                        {
                            <span class="text-danger">-$@Math.Abs(Model.BudgetRemaining).ToString("N2") (Over Budget)</span>
                        }
                    </div>
                </div>
            </div>
            <a asp-page="/Lists/ListDetails" asp-route-listId="@Model.ContextList.listID" class="btn btn-outline-@statusClass">
                <i class="bi bi-eye me-1"></i>View List
            </a>
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="mb-3 d-flex flex-wrap gap-3 align-items-center">
            @* Hidden field to preserve context list *@
            @if (Model.ContextListId.HasValue)
            {
                <input type="hidden" name="ContextListId" value="@Model.ContextListId" />
            }

            <!-- Search input -->
            <input type="text"
                   name="Search"
                   value="@Model.Search" 
                   class="form-control"
                   style="max-width: 280px;"
                   placeholder="Search products..." />

            <!-- Search button -->
            <button class="btn btn-primary" type="submit">
                Search
            </button>

            <!-- Budget Filter Toggle (only show if budget features active) -->
            @if (Model.ShowBudgetFeatures && Model.BudgetRemaining > 0)
            {
                <div class="form-check">
                    <input class="form-check-input" 
                           type="checkbox" 
                           name="FilterByBudget" 
                           id="filterByBudget"
                           value="true"
                           checked="@Model.FilterByBudget"
                           onchange="this.form.submit()" />
                    <label class="form-check-label" for="filterByBudget">
                        <i class="bi bi-funnel me-1"></i>
                        <strong>Only show items within budget</strong>
                    </label>
                </div>
            }

            <!-- Sort dropdown -->
            <select name="Sort"
                    class="form-select"
                    style="max-width: 220px;"
                    onchange="this.form.submit()">
                <option value="">Sort By</option>
                <option value="name_asc" selected="@(Model.Sort == "name_asc")">Name (A → Z)</option>
                <option value="name_desc" selected="@(Model.Sort == "name_desc")">Name (Z → A)</option>
                <option value="price_asc" selected="@(Model.Sort == "price_asc")">Price (Low → High)</option>
                <option value="price_desc" selected="@(Model.Sort == "price_desc")">Price (High → Low)</option>
            </select>

            <!-- Clear Search -->
            <a href="?Sort=@Model.Sort&ContextListId=@Model.ContextListId&pageNumber=1"
               class="btn btn-outline-secondary">
                Clear Search
            </a>

            <!-- Reset Sort -->
            <a href="?Search=@Model.Search&ContextListId=@Model.ContextListId&pageNumber=1"
               class="btn btn-outline-secondary">
                Reset Sort
            </a>

        </form>
    </div>
</div>

@{
    string sortLabel =
        Model.Sort == "name_asc" ? "Name (A → Z)" :
        Model.Sort == "name_desc" ? "Name (Z → A)" :
        Model.Sort == "price_asc" ? "Price (Low → High)" :
        Model.Sort == "price_desc" ? "Price (High → Low)" :
        "Default";
}

@* "Showing X–Y of Z results" *@
@{
    int startItem = 0;
    int endItem = 0;

    if (Model.TotalItems > 0)
    {
        startItem = (Model.PageNumber - 1) * Model.PageSize + 1;
        endItem = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems);
    }
}

@if (Model.TotalItems > 0 && (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Sort) || Model.FilterByBudget))
{
    <p class="text-muted mb-1">
        Showing @startItem–@endItem of @Model.TotalItems results
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <span> for "<strong>@Model.Search</strong>"</span>
        }
        @if (Model.FilterByBudget)
        {
            <span> <span class="badge bg-success">Within Budget</span></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Sort))
        {
            <span>
                @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.FilterByBudget)
                {
                    @: ,&nbsp;
                }
                sorted by <strong>@sortLabel</strong>
            </span>
        }
    </p>
}
else if (Model.TotalItems > 0)
{
    <p class="text-muted mb-1">
        Showing @startItem–@endItem of @Model.TotalItems results
    </p>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Products.Any())
{
    <p class="text-muted mt-3">
        No products match your search or filters.
    </p>
}
else
{
    @* Build a list of non-imported lists for the picker *@
    var addableLists = Model.UserLists
        .Where(l => !Model.ImportedListIds.Contains(l.listID))
        .ToList();

    <div class="row">
        @foreach (var item in Model.Products)
        {
            // Budget indicator logic
            bool isWithinBudget = !Model.ShowBudgetFeatures || Model.BudgetRemaining >= item.retail_price;
            bool isOverBudget = Model.ShowBudgetFeatures && Model.BudgetRemaining < item.retail_price;
            string budgetBadgeClass = isWithinBudget ? "bg-success" : "bg-danger";
            string budgetBadgeText = isWithinBudget ? "Within Budget" : "Over Budget";
            
            <div class="col-md-4 mb-4" style="z-index: auto;">
                <div class="card h-100 shadow-sm product-card position-relative" onclick="window.location='/ProductPages/Listing/@item.product_ID'" style="overflow: visible;">
                    @* Budget Badge *@
                    @if (Model.ShowBudgetFeatures)
                    {
                        <span class="position-absolute top-0 end-0 m-2 badge @budgetBadgeClass" style="z-index: 1;">
                            @if (isWithinBudget)
                            {
                                <i class="bi bi-check-circle me-1"></i>
                            }
                            else
                            {
                                <i class="bi bi-exclamation-triangle me-1"></i>
                            }
                        </span>
                    }
                    
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.product_name</h5>
                        @if (!string.IsNullOrEmpty(item.ImageURL))
                        {
                            <img src="@item.ImageURL" alt="@item.product_name" class="card-img-top mb-3" style="height: 100px; object-fit: contain;" />
                        }
                        else
                        {
                            <p class="card-text text-muted">
                                Image Not Available
                            </p>
                        }
                        <p class="card-text">
                            @item.description
                        </p>

                        <p class="fw-bold">
                            Price: $@item.retail_price
                        </p>

                        @if (item.rating.HasValue || item.reviews.HasValue)
                        {
                            <p class="card-text">
                                @if (item.rating.HasValue)
                                {
                                    <span class="text-warning">★ @item.rating.Value.ToString("0.0")</span>
                                }
                                @if (item.reviews.HasValue)
                                {
                                    <span class="text-muted">(@item.reviews.Value.ToString("N0") reviews)</span>
                                }
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(item.source_name))
                        {
                            <p class="card-text text-muted small">
                                @if (!string.IsNullOrEmpty(item.source_logo))
                                {
                                    <img src="@item.source_logo" alt="@item.source_name" style="height: 16px; width: 16px; margin-right: 4px;" />
                                }
                                @item.source_name
                            </p>
                        }

                        <p>
                            Bulk Availability:
                            <span class="fw-semibold">
                                @(item.bulk_availability ? "Available" : "Not Available")
                            </span>
                        </p>

                        <!-- Push buttons to bottom with margin-top auto -->
                        <div class="mt-auto pt-3" onclick="event.stopPropagation();">
                            <!-- First row: View Details and View Source buttons -->
                            <div class="d-grid gap-2 mb-2">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <a href="/ProductPages/Listing/@item.product_ID" class="btn btn-primary w-100">
                                            View Details
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a href="@item.retail_URL" class="btn btn-success w-100" target="_blank" title="@item.source_name">
                                            @{
                                                var sourceName = item.source_name ?? "Site";
                                                var displayName = sourceName.Length > 10 ? sourceName.Substring(0, 10) + "…" : sourceName;
                                            }
                                            View @displayName
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Second row: Add to List button (full width) -->
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @if (addableLists.Any())
                                {
                                    <div class="dropdown d-grid" style="position: static;">
                                        <button class="btn btn-warning dropdown-toggle w-100"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                style="position: relative; z-index: 1;">
                                            Add to List
                                        </button>
                                        <ul class="dropdown-menu w-100" style="position: absolute; z-index: 1060 !important;">
                                            @* Context list gets priority if present *@
                                            @if (Model.ContextListId.HasValue && addableLists.Any(l => l.listID == Model.ContextListId.Value))
                                            {
                                                var contextList = addableLists.First(l => l.listID == Model.ContextListId.Value);
                                                <li>
                                                    <form method="post" asp-page-handler="AddToList">
                                                        <input type="hidden" name="productId" value="@item.product_ID" />
                                                        <input type="hidden" name="listId" value="@contextList.listID" />
                                                        <button type="submit" class="dropdown-item fw-bold">
                                                            <i class="bi bi-star-fill text-warning me-2"></i>
                                                            @(contextList.title ?? "Untitled List")
                                                        </button>
                                                    </form>
                                                </li>
                                                @if (addableLists.Count > 1)
                                                {
                                                    <li><hr class="dropdown-divider" /></li>
                                                }
                                            }
                                            
                                            @foreach (var list in addableLists.Where(l => l.listID != Model.ContextListId))
                                            {
                                                <li>
                                                    <form method="post" asp-page-handler="AddToList">
                                                        <input type="hidden" name="productId" value="@item.product_ID" />
                                                        <input type="hidden" name="listId" value="@list.listID" />
                                                        <button type="submit" class="dropdown-item">
                                                            @(list.title ?? "Untitled List")
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <a class="dropdown-item text-primary" href="/Lists/CreateList">
                                                    + Create New List
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <a href="/Lists/CreateList" class="btn btn-warning w-100">
                                        Create a List First
                                    </a>
                                }
                            }
                            else
                            {
                                <a href="/Identity/Account/Login" class="btn btn-warning w-100">
                                    Log in to Add
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (Model.TotalPages > 1)
{
    int windowSize = 10;
    int pageWindowStart = (Model.PageNumber - 1) / windowSize * windowSize + 1;
    int windowEnd = Math.Min(pageWindowStart + windowSize - 1, Model.TotalPages);
    bool hasPrevWindow = pageWindowStart > 1;
    bool hasNextWindow = windowEnd < Model.TotalPages;
    int prevWindowStart = pageWindowStart - windowSize;
    int nextWindowStart = pageWindowStart + windowSize;

    <nav aria-label="Product catalog pages">
        <ul class="pagination justify-content-center mt-4 flex-wrap">

        <!-- Previous Page -->
        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
            <a class="page-link"
               href="?Search=@Model.Search&Sort=@Model.Sort&ContextListId=@Model.ContextListId&FilterByBudget=@Model.FilterByBudget&pageNumber=@(Model.PageNumber - 1)">
                &laquo;
            </a>
        </li>

        <!-- Previous Window (…) -->
        @if (hasPrevWindow)
        {
            <li class="page-item">
                <a class="page-link text-secondary"
                   href="?Search=@Model.Search&Sort=@Model.Sort&ContextListId=@Model.ContextListId&FilterByBudget=@Model.FilterByBudget&pageNumber=@prevWindowStart"
                   title="Pages @prevWindowStart–@(pageWindowStart - 1)">
                    &hellip;
                </a>
            </li>
        }

        <!-- Page Numbers (current window only) -->
        @for (int i = pageWindowStart; i <= windowEnd; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link"
                   href="?Search=@Model.Search&Sort=@Model.Sort&ContextListId=@Model.ContextListId&FilterByBudget=@Model.FilterByBudget&pageNumber=@i">
                    @i
                </a>
            </li>
        }

        <!-- Next Window (…) -->
        @if (hasNextWindow)
        {
            <li class="page-item">
                <a class="page-link text-secondary"
                   href="?Search=@Model.Search&Sort=@Model.Sort&ContextListId=@Model.ContextListId&FilterByBudget=@Model.FilterByBudget&pageNumber=@nextWindowStart"
                   title="Pages @nextWindowStart–@(Math.Min(nextWindowStart + windowSize - 1, Model.TotalPages))">
                    &hellip;
                </a>
            </li>
        }

        <!-- Next Page -->
        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
            <a class="page-link"
               href="?Search=@Model.Search&Sort=@Model.Sort&ContextListId=@Model.ContextListId&FilterByBudget=@Model.FilterByBudget&pageNumber=@(Model.PageNumber + 1)">
                &raquo;
            </a>
        </li>

    </ul>
    </nav>
}

@section Scripts {
    <script>
        // Fix dropdown z-index when opened
        document.addEventListener('DOMContentLoaded', function() {
            const dropdowns = document.querySelectorAll('.dropdown-toggle');
            
            dropdowns.forEach(dropdown => {
                dropdown.addEventListener('shown.bs.dropdown', function() {
                    // Find the parent column and set z-index
                    const parentCol = this.closest('.col-md-4');
                    if (parentCol) {
                        parentCol.style.zIndex = '1070';
                        parentCol.style.position = 'relative';
                    }
                });
                
                dropdown.addEventListener('hidden.bs.dropdown', function() {
                    // Reset z-index when dropdown closes
                    const parentCol = this.closest('.col-md-4');
                    if (parentCol) {
                        parentCol.style.zIndex = '';
                        parentCol.style.position = '';
                    }
                });
            });
        });
    </script>
}

