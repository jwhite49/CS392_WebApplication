@page
@model CS392_WebApplication.Pages.ProductPages.Catalog.IndexModel

<h2 class="mb-4">Product Catalog</h2>
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="mb-3 d-flex flex-wrap gap-3 align-items-center">
    <!--Possibly add "category" from index page to search from quick search buttons on homepage-->
            <!-- Search input -->
            <input type="text"
                   name="Search"
                   value="@Model.Search" 
                   class="form-control"
                   style="max-width: 280px;"
                   placeholder="Search products..." />

            <!-- Search button -->
            <button class="btn btn-primary" type="submit">
                Search
            </button>

            <!-- Clear ONLY search (keeps Sort, resets to page 1) -->
            <a href="?Sort=@Model.Sort&pageNumber=1"
               class="btn btn-outline-secondary">
                Clear Search
            </a>

            <!-- Sort dropdown -->
            <select name="Sort"
                    class="form-select"
                    style="max-width: 220px;"
                    onchange="this.form.submit()">
                <option value="">Sort By</option>
                <option value="name_asc" selected="@(Model.Sort == "name_asc")">Name (A → Z)</option>
                <option value="name_desc" selected="@(Model.Sort == "name_desc")">Name (Z → A)</option>
                <option value="price_asc" selected="@(Model.Sort == "price_asc")">Price (Low → High)</option>
                <option value="price_desc" selected="@(Model.Sort == "price_desc")">Price (High → Low)</option>
            </select>

            <!-- Reset ONLY sort (keeps Search, resets to page 1) -->
            <a href="?Search=@Model.Search&pageNumber=1"
               class="btn btn-outline-secondary">
                Reset Sort
            </a>

        </form>
    </div>
</div>
@{
    string sortLabel =
        Model.Sort == "name_asc" ? "Name (A → Z)" :
        Model.Sort == "name_desc" ? "Name (Z → A)" :
        Model.Sort == "price_asc" ? "Price (Low → High)" :
        Model.Sort == "price_desc" ? "Price (High → Low)" :
        "Default";
}
@* "Showing X–Y of Z results" *@
@{
    int startItem = 0;
    int endItem = 0;

    if (Model.TotalItems > 0)
    {
        startItem = (Model.PageNumber - 1) * Model.PageSize + 1;
        endItem = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems);
    }
}

@if (Model.TotalItems > 0 && (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Sort)))
{
    <p class="text-muted mb-1">
        Showing @startItem–@endItem of @Model.TotalItems results
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <span> for "<strong>@Model.Search</strong>"</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Sort))
        {
            <span>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    @: ,&nbsp;
                }
                sorted by <strong>@sortLabel</strong>
            </span>
        }
    </p>
}

else if (Model.TotalItems > 0)
{
    <p class="text-muted mb-1">
        Showing @startItem–@endItem of @Model.TotalItems results
    </p>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Products.Any())
{
    <p class="text-muted mt-3">
        No products match your search or filters.
    </p>
}
else
{
    @* Build a list of non-imported lists for the picker *@
    var addableLists = Model.UserLists
        .Where(l => !Model.ImportedListIds.Contains(l.listID))
        .ToList();

    <div class="row">
        @foreach (var item in Model.Products)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm product-card" onclick="window.location='/ProductPages/Listing/@item.product_ID'">
                    <div class="card-body">
                        <h5 class="card-title">@item.product_name</h5>
                        @if (!string.IsNullOrEmpty(item.ImageURL))
                        {
                            <img src="@item.ImageURL" alt="@item.product_name" class="card-img-top mb-3" style="height: 100px; object-fit: contain;" />
                        }
                        else
                        {
                            <p class="card-text text-muted">
                                Image Not Available
                            </p>
                        }
                        <p class="card-text">
                            @item.description
                        </p>

                        <p class="fw-bold">
                            Price: $@item.retail_price
                        </p>

                        @if (item.rating.HasValue || item.reviews.HasValue)
                        {
                            <p class="card-text">
                                @if (item.rating.HasValue)
                                {
                                    <span class="text-warning">★ @item.rating.Value.ToString("0.0")</span>
                                }
                                @if (item.reviews.HasValue)
                                {
                                    <span class="text-muted">(@item.reviews.Value.ToString("N0") reviews)</span>
                                }
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(item.source_name))
                        {
                            <p class="card-text text-muted small">
                                @if (!string.IsNullOrEmpty(item.source_logo))
                                {
                                    <img src="@item.source_logo" alt="@item.source_name" style="height: 16px; width: 16px; margin-right: 4px;" />
                                }
                                @item.source_name
                            </p>
                        }

                        <p>
                            Bulk Availability:
                            <span class="fw-semibold">
                                @(item.bulk_availability ? "Available" : "Not Available")
                            </span>
                        </p>

                        <div class="d-flex flex-wrap gap-2 mt-3" onclick="event.stopPropagation();">
                            <a href="/ProductPages/Listing/@item.product_ID" class="btn btn-primary">
                                View Details
                            </a>

                            <a href="@item.retail_URL" class="btn btn-success" target="_blank">
                                View @(item.source_name?.Length > 8 ? item.source_name.Substring(0, 8) + "…" : item.source_name)
                            </a>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @if (addableLists.Any())
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-warning dropdown-toggle"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false">
                                            Add to List
                                        </button>
                                        <ul class="dropdown-menu">
                                            @foreach (var list in addableLists)
                                            {
                                                <li>
                                                    <form method="post" asp-page-handler="AddToList">
                                                        <input type="hidden" name="productId" value="@item.product_ID" />
                                                        <input type="hidden" name="listId" value="@list.listID" />
                                                        <button type="submit" class="dropdown-item">
                                                            @(list.title ?? "Untitled List")
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <a class="dropdown-item text-primary" href="/Lists/CreateList">
                                                    + Create New List
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <a href="/Lists/CreateList" class="btn btn-warning">
                                        Create a List First
                                    </a>
                                }
                            }
                            else
                            {
                                <a href="/Identity/Account/Login" class="btn btn-warning">
                                    Log in to Add
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

}

@if (Model.TotalPages > 1)
{
    int windowSize = 10;
    int pageWindowStart = (Model.PageNumber - 1) / windowSize * windowSize + 1;
    int windowEnd = Math.Min(pageWindowStart + windowSize - 1, Model.TotalPages);
    bool hasPrevWindow = pageWindowStart > 1;
    bool hasNextWindow = windowEnd < Model.TotalPages;
    int prevWindowStart = pageWindowStart - windowSize;
    int nextWindowStart = pageWindowStart + windowSize;

    <nav aria-label="Product catalog pages">
        <ul class="pagination justify-content-center mt-4 flex-wrap">

        <!-- Previous Page -->
        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
            <a class="page-link"
               href="?Search=@Model.Search&Sort=@Model.Sort&pageNumber=@(Model.PageNumber - 1)">
                &laquo;
            </a>
        </li>

        <!-- Previous Window (…) -->
        @if (hasPrevWindow)
        {
            <li class="page-item">
                <a class="page-link text-secondary"
                   href="?Search=@Model.Search&Sort=@Model.Sort&pageNumber=@prevWindowStart"
                   title="Pages @prevWindowStart–@(pageWindowStart - 1)">
                    &hellip;
                </a>
            </li>
        }

        <!-- Page Numbers (current window only) -->
        @for (int i = pageWindowStart; i <= windowEnd; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link"
                   href="?Search=@Model.Search&Sort=@Model.Sort&pageNumber=@i">
                    @i
                </a>
            </li>
        }

        <!-- Next Window (…) -->
        @if (hasNextWindow)
        {
            <li class="page-item">
                <a class="page-link text-secondary"
                   href="?Search=@Model.Search&Sort=@Model.Sort&pageNumber=@nextWindowStart"
                   title="Pages @nextWindowStart–@(Math.Min(nextWindowStart + windowSize - 1, Model.TotalPages))">
                    &hellip;
                </a>
            </li>
        }

        <!-- Next Page -->
        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
            <a class="page-link"
               href="?Search=@Model.Search&Sort=@Model.Sort&pageNumber=@(Model.PageNumber + 1)">
                &raquo;
            </a>
        </li>

    </ul>
    </nav>
}