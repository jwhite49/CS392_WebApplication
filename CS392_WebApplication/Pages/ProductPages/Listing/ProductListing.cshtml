@page "/ProductPages/Listing/{id:int}"
@model ProductListingModel
@{
    ViewData["Title"] = Model.Product.product_name;

    var addableLists = Model.UserLists
        .Where(l => !Model.ImportedListIds.Contains(l.listID))
        .ToList();
}

<div class="container mt-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex justify-content-between align-items-center" role="alert">
            <div>
                @TempData["SuccessMessage"]
            </div>

            <div class="d-flex gap-2">

                <!-- View My Lists -->
                <a href="/Lists/List" class="btn btn-sm btn-primary">
                    View My Lists
                </a>

                <!-- Undo Button -->
                @if (TempData["UndoProductId"] is int undoPid && TempData["UndoListId"] is int undoLid)
                {
                    <form method="post" asp-page-handler="UndoAdd" class="d-inline">
                        <input type="hidden" name="productId" value="@undoPid" />
                        <input type="hidden" name="listId" value="@undoLid" />
                        <button type="submit" class="btn btn-sm btn-warning">
                            Undo
                        </button>
                    </form>
                }

                <!-- Close Alert -->
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Back to Catalog -->
    <a href="/ProductPages/Catalog/Index" class="btn btn-secondary mb-3">
        ← Back to Catalog
    </a>

    <!-- Product Title -->
    <h2 class="mb-4">@Model.Product.product_name</h2>

    <div class="row">

        <!-- LEFT: Main Image -->
        <div class="col-md-5 text-center mb-4">
            <img src="@Model.Product.ImageURL"
                 alt="@Model.Product.product_name"
                 class="img-fluid rounded shadow-sm"
                 style="max-height: 350px; object-fit: contain;" />
        </div>

        <!-- RIGHT: Product Info -->
        <div class="col-md-7">

            <!-- Rating + Reviews -->
            <div class="mb-3">
                <h5 class="mb-1">Rating</h5>
                @if (Model.Product.rating.HasValue)
                {
                    <p class="mb-0">
                        ⭐ @Model.Product.rating / 5
                        <span class="text-muted">(@Model.Product.reviews reviews)</span>
                    </p>
                }
                else
                {
                    <p class="text-muted">No rating available</p>
                }
            </div>

            <!-- Price -->
            <div class="mb-3">
                <h5 class="mb-1">Price</h5>
                <p class="fs-4 fw-bold">$@Model.Product.retail_price</p>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <h5 class="mb-1">Description</h5>
                <p>@Model.Product.description</p>
            </div>

            <!-- Sample Review -->
            @if (!string.IsNullOrWhiteSpace(Model.Product.sample_review))
            {
                <div class="mb-3">
                    <h5 class="mb-1">Sample Review</h5>
                    <blockquote class="blockquote">
                        <p class="mb-0">"@Model.Product.sample_review"</p>
                    </blockquote>
                </div>
            }

            <!-- Retailer Link -->
            @{
                var encodedName = Uri.EscapeDataString(Model.Product.product_name ?? "");
            }
            <div class="mt-4 p-3 border rounded bg-light" id="buy-section">
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <h5 class="mb-0">Buy This Item</h5>
                    <span class="text-muted" style="font-size: 0.75rem;">Pulled from @Model.Product.source_name</span>
                </div>

                <!-- AI-populated links slot (filled on load) -->
                <div id="buy-links-result">
                    <div class="text-muted small">
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        Finding best prices…
                    </div>
                </div>
            </div>

            <!-- AI Price Search section removed — merged into Buy This Item -->

            <!-- Add to List Picker -->
            <div class="mt-4">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (addableLists.Any())
                    {
                        <div class="dropdown">
                            <button class="btn btn-success dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                + Add to My List
                            </button>
                            <ul class="dropdown-menu">
                                @foreach (var list in addableLists)
                                {
                                    <li>
                                        <form method="post" asp-page-handler="AddToList">
                                            <input type="hidden" name="productId" value="@Model.Product.product_ID" />
                                            <input type="hidden" name="listId" value="@list.listID" />
                                            <button type="submit" class="dropdown-item">
                                                @(list.title ?? "Untitled List")
                                            </button>
                                        </form>
                                    </li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item text-primary" href="/Lists/CreateList">
                                        + Create New List
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Lists/CreateList" class="btn btn-success">
                            Create a List First
                        </a>
                    }
                }
                else
                {
                    <a href="/Identity/Account/Login" class="btn btn-success">
                        Log in to Add to List
                    </a>
                }
            </div>

        </div>
    </div>

    @if (Model.RecommendedProducts.Any())
    {
        <div class="mt-5">
            <h5 class="mb-3">Recommended</h5>
            <div class="d-flex gap-3 overflow-auto pb-2" style="scroll-snap-type: x mandatory;">
                @foreach (var item in Model.RecommendedProducts)
                {
                    <a href="/ProductPages/Listing/@item.product_ID"
                       class="text-decoration-none text-dark rec-card-link"
                       style="min-width: 160px; max-width: 160px; scroll-snap-align: start;">
                        <div class="card h-100 shadow-sm">
                            @if (!string.IsNullOrEmpty(item.ImageURL))
                            {
                                <img src="@item.ImageURL"
                                     alt="@item.product_name"
                                     class="card-img-top p-2"
                                     style="height: 100px; object-fit: contain;" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center bg-light"
                                     style="height: 100px;">
                                    <span class="text-muted small">No image</span>
                                </div>
                            }
                            <div class="card-body p-2">
                                <p class="card-title small fw-semibold mb-1" style="
                                    display: -webkit-box;
                                    -webkit-line-clamp: 2;
                                    -webkit-box-orient: vertical;
                                    overflow: hidden;">@item.product_name</p>
                                <p class="text-success fw-bold small mb-0">$@item.retail_price.ToString("0.00")</p>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    }

</div>

@section Scripts {
<style>
    .rec-card-link .card {
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .rec-card-link:hover .card {
        transform: translateY(-5px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15) !important;
    }
</style>
<script>
// SerpAPI fallback links built server-side
const serpFallbackLinks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.PriceComparisons.Select(o => new { source = o.Source, logo = o.Logo ?? "", price = o.Price, url = o.Url }).ToList()
));

// Fallback: render SerpAPI links (or Google Shopping search)
function renderFallback() {
    const resultDiv = document.getElementById('buy-links-result');
    if (serpFallbackLinks && serpFallbackLinks.length > 0) {
        let html = '<div class="d-flex flex-wrap gap-2">';
        for (const offer of serpFallbackLinks) {
            const price = offer.price > 0 ? `$${offer.price.toFixed(2)}` : '';
            html += `<a href="${offer.url}" target="_blank" rel="noopener" class="btn btn-primary d-flex align-items-center gap-2">
                ${offer.logo ? `<img src="${offer.logo}" alt="${offer.source}" style="height:18px;">` : ''}
                <span>Buy on ${offer.source}</span>
                ${price ? `<span class="fw-bold">· ${price}</span>` : ''}
            </a>`;
        }
        html += '</div><p class="text-muted small mt-2 mb-0">Prices from product retailers</p>';
        resultDiv.innerHTML = html;
    } else {
        const encodedName = encodeURIComponent('@Model.Product.product_name');
        resultDiv.innerHTML = `
            <a href="https://www.google.com/search?tbm=shop&q=${encodedName}" target="_blank" rel="noopener" class="btn btn-primary mt-1">Search on Google Shopping</a>
            <button onclick="loadBuyLinks()" class="btn btn-outline-secondary mt-1 ms-2">↩ Retry</button>
        `;
    }
}

async function loadBuyLinks() {
    const resultDiv = document.getElementById('buy-links-result');
    const productId = @Model.Product.product_ID;

    resultDiv.innerHTML = '<div class="text-muted small"><span class="spinner-border spinner-border-sm me-1" role="status"></span>Finding best prices…</div>';

    try {
        const resp = await fetch(`?handler=GeminiPrices&id=${productId}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const json = await resp.json();

        let items = null;
        if (json.success) {
            try {
                const cleaned = json.data.replace(/```json|```/g, '').trim();
                const startIdx = cleaned.indexOf('[');
                const endIdx = cleaned.lastIndexOf(']');
                if (startIdx !== -1 && endIdx !== -1) {
                    items = JSON.parse(cleaned.substring(startIdx, endIdx + 1));
                }
            } catch (_) { /* fall through */ }
        }

        if (items && Array.isArray(items) && items.length > 0) {
            let html = '<div class="d-flex flex-wrap gap-2">';
            for (const item of items) {
                const source = item.source || 'Retailer';
                const price = item.price > 0 ? `$${parseFloat(item.price).toFixed(2)}` : '';
                const url = item.url && item.url.startsWith('http') ? item.url : null;
                if (!url) continue;
                html += `<a href="${url}" target="_blank" rel="noopener" class="btn btn-primary d-flex align-items-center gap-2">
                    <span>Buy on ${source}</span>
                    ${price ? `<span class="fw-bold">· ${price}</span>` : ''}
                </a>`;
            }
            html += '</div><p class="text-muted small mt-2 mb-0">Prices found by AI</p>';
            // Only use AI result if we actually built at least one link
            if (html.includes('<a ')) {
                resultDiv.innerHTML = html;
                return;
            }
        }

        // AI returned nothing useful — fall back to SerpAPI
        renderFallback();
    } catch (err) {
        renderFallback();
    }
}

document.addEventListener('DOMContentLoaded', loadBuyLinks);
</script>
}
