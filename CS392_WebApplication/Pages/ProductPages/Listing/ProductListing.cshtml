@page "/ProductPages/Listing/{id:int}"
@model ProductListingModel
@{
    ViewData["Title"] = Model.Product.product_name;

    var addableLists = Model.UserLists
        .Where(l => !Model.ImportedListIds.Contains(l.listID))
        .ToList();
}

<div class="container mt-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex justify-content-between align-items-center" role="alert">
            <div>
                @TempData["SuccessMessage"]
            </div>

            <div class="d-flex gap-2">

                <!-- View My Lists -->
                <a href="/Lists/List" class="btn btn-sm btn-primary">
                    View My Lists
                </a>

                <!-- Undo Button -->
                @if (TempData["UndoProductId"] is int undoPid && TempData["UndoListId"] is int undoLid)
                {
                    <form method="post" asp-page-handler="UndoAdd" class="d-inline">
                        <input type="hidden" name="productId" value="@undoPid" />
                        <input type="hidden" name="listId" value="@undoLid" />
                        <button type="submit" class="btn btn-sm btn-warning">
                            Undo
                        </button>
                    </form>
                }

                <!-- Close Alert -->
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Back to Catalog -->
    <a href="/ProductPages/Catalog/Index" class="btn btn-secondary mb-3">
        ← Back to Catalog
    </a>

    <!-- Product Title -->
    <h2 class="mb-4">@Model.Product.product_name</h2>

    <div class="row">

        <!-- LEFT: Main Image -->
        <div class="col-md-5 text-center mb-4">
            <img src="@Model.Product.ImageURL"
                 alt="@Model.Product.product_name"
                 class="img-fluid rounded shadow-sm"
                 style="max-height: 350px; object-fit: contain;" />
        </div>

        <!-- RIGHT: Product Info -->
        <div class="col-md-7">

            <!-- Rating + Reviews -->
            <div class="mb-3">
                <h5 class="mb-1">Rating</h5>
                @if (Model.Product.rating.HasValue)
                {
                    <p class="mb-0">
                        ⭐ @Model.Product.rating / 5
                        <span class="text-muted">(@Model.Product.reviews reviews)</span>
                    </p>
                }
                else
                {
                    <p class="text-muted">No rating available</p>
                }
            </div>

            <!-- Price -->
            <div class="mb-3">
                <h5 class="mb-1">Price</h5>
                <p class="fs-4 fw-bold">$@Model.Product.retail_price</p>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <h5 class="mb-1">Description</h5>
                <p>@Model.Product.description</p>
            </div>

            <!-- Sample Review -->
            @if (!string.IsNullOrWhiteSpace(Model.Product.sample_review))
            {
                <div class="mb-3">
                    <h5 class="mb-1">Sample Review</h5>
                    <blockquote class="blockquote">
                        <p class="mb-0">"@Model.Product.sample_review"</p>
                    </blockquote>
                </div>
            }

            <!-- Retailer Link -->
            <div class="mt-4 p-3 border rounded bg-light">
                <h5>Buy This Item</h5>

                @if (!string.IsNullOrWhiteSpace(Model.Product.retail_URL))
                {
                    <a href="@Model.Product.retail_URL"
                       target="_blank"
                       rel="noopener"
                       class="btn btn-primary mt-2">

                        @if (!string.IsNullOrWhiteSpace(Model.Product.source_logo))
                        {
                            <img src="@Model.Product.source_logo"
                                 alt="@Model.Product.source_name"
                                 style="height: 20px; margin-right: 8px;" />
                        }

                        Buy on @(Model.Product.source_name ?? "Retailer")
                    </a>
                }
                else
                {
                    <p class="text-muted">No retailer link available</p>
                }
            </div>

            <!-- Compare Prices -->
            <div class="mt-4 p-3 border rounded bg-light">
                <h5 class="mb-3">Compare Prices</h5>
                @if (Model.PriceComparisons.Any())
                {
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var offer in Model.PriceComparisons)
                        {
                            <a href="@offer.Url"
                               target="_blank"
                               rel="noopener"
                               class="btn btn-outline-secondary d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(offer.Logo))
                                {
                                    <img src="@offer.Logo" alt="@offer.Source" style="height: 18px;" />
                                }
                                <span>@offer.Source</span>
                                @if (offer.Price > 0)
                                {
                                    <span class="fw-bold text-success">$@offer.Price.ToString("0.00")</span>
                                }
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No price comparisons found for this product.</p>
                }
            </div>

            <!-- Add to List Picker -->
            <div class="mt-4">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (addableLists.Any())
                    {
                        <div class="dropdown">
                            <button class="btn btn-success dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                + Add to My List
                            </button>
                            <ul class="dropdown-menu">
                                @foreach (var list in addableLists)
                                {
                                    <li>
                                        <form method="post" asp-page-handler="AddToList">
                                            <input type="hidden" name="productId" value="@Model.Product.product_ID" />
                                            <input type="hidden" name="listId" value="@list.listID" />
                                            <button type="submit" class="dropdown-item">
                                                @(list.title ?? "Untitled List")
                                            </button>
                                        </form>
                                    </li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item text-primary" href="/Lists/CreateList">
                                        + Create New List
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Lists/CreateList" class="btn btn-success">
                            Create a List First
                        </a>
                    }
                }
                else
                {
                    <a href="/Identity/Account/Login" class="btn btn-success">
                        Log in to Add to List
                    </a>
                }
            </div>

        </div>
    </div>

</div>
