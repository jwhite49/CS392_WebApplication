@page "{category}"
@model ProductListingModel
@{
    ViewData["Title"] = "ProductListing";
}

<h1>Product: @Model.Product.product_name</h1>
<br/>

<div class="flex-container">
    <div class="item-smallPicture">
        <h1>Pictures</h1>
    </div>
    <div class="item-mainPicture">
        <h1> </h1>
        <img src="@Model.Product.ImageURL" alt="@Model.Product.product_name" style="max-width: 40%; min-height: 70%;"/>
    </div>
    <div class="item-description">
        <h2>@Model.Product.product_name</h2>
        <p> Rating: @Model.Product.rating</p>
        <p> Review: @Model.Product.reviews</p>
        <p> Price: $@Model.Product.retail_price</p>
    </div>
    <div class="item-otherSites">
        <h1> Other sites</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Product.retail_URL))
        {
            <a href="@Model.Product.retail_URL" target="_blank" rel="noopener">
                Buy on @(Model.Product.source_name ?? "Retailer")
            </a>
        }
        else
        {
            <span class="text-muted">No retailer link available</span>
        }
    </div>
</div>


