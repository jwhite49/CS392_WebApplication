@page
@model CS392_WebApplication.Pages.Product_List_Pages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Product_list</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Product_list.listID" />
            <div class="form-group">
                <label asp-for="Product_list.userID" class="control-label"></label>
                <input asp-for="Product_list.userID" class="form-control" />
                <span asp-validation-for="Product_list.userID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product_list.total_price" class="control-label"></label>
                <input asp-for="Product_list.total_price" class="form-control" />
                <span asp-validation-for="Product_list.total_price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product_list.list_type" class="control-label"></label>
                <select asp-for="Product_list.list_type" asp-items="Model.ListTypeOptions" class="form-control"></select>
                <span asp-validation-for="Product_list.list_type" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product_list.created_at" class="control-label"></label>
                <input asp-for="Product_list.created_at" class="form-control" />
                <span asp-validation-for="Product_list.created_at" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
