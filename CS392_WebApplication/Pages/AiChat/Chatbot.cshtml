@page
@model CS392_WebApplication.Pages.AiChat.ChatbotModel
@{
    ViewData["Title"] = "Supply Assistant";
}

<div class="container mt-4">
    <h1 class="mb-4">Supply Category Assistant</h1>
    <p class="text-muted mb-4">Select a supply category and ask the assistant for help finding the right items.</p>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label for="SelectedCategory" class="form-label">Select a Category (Optional)</label>
                            <select asp-for="SelectedCategory" class="form-select">
                                <option value="">-- Browse all categories --</option>
                                @foreach (var category in Model.Catalog.Keys)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                            <small class="text-muted">Choose a category to focus your question, or leave blank for general help</small>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.SelectedCategory) && Model.Catalog.TryGetValue(Model.SelectedCategory, out var items))
                        {
                            <div class="mb-3">
                                <label class="form-label text-muted">Items in this category:</label>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var item in items)
                                    {
                                        <span class="badge bg-secondary">@item</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label for="UserQuestion" class="form-label">Your Question</label>
                            <textarea asp-for="UserQuestion" class="form-control" rows="4" placeholder="e.g., What writing supplies do I need for college? What's the difference between markers and highlighters?"></textarea>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary" disabled="@(Model.IsProcessing ? "disabled" : null)">
                                @(Model.IsProcessing ? "Processing..." : "Ask Assistant")
                            </button>
                        </div>

                        <div asp-validation-summary="All" class="text-danger mt-3"></div>
                    </form>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.AIResponse))
            {
                <div class="card mt-4 shadow-sm">
                    <div class="card-header bg-success text-white">
                        <strong>Assistant Response</strong>
                    </div>
                    <div class="card-body">
                        <div style="white-space: pre-wrap;">@Model.AIResponse</div>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <strong>Example Questions</strong>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">"What writing supplies do I need for high school?"</li>
                        <li class="mb-2">"What's in the art supplies category?"</li>
                        <li class="mb-2">"What organization tools are best for a binder?"</li>
                        <li class="mb-2">"What math tools do I need for geometry?"</li>
                        <li class="mb-2">"What digital supplies should a student have?"</li>
                    </ul>
                </div>
            </div>

            @if (Model.Catalog.Count > 0)
            {
                <div class="card shadow-sm mt-3">
                    <div class="card-header bg-secondary text-white">
                        <strong>All Categories</strong>
                    </div>
                    <div class="card-body p-2">
                        <ul class="list-unstyled mb-0">
                            @foreach (var cat in Model.Catalog.Keys)
                            {
                                <li><small class="text-muted">@cat (@Model.Catalog[cat].Count items)</small></li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
</div>