@page
@model CS392_WebApplication.Pages.Admin.SystemLogs.IndexModel
@{
    ViewData["Title"] = "System Logs";
}

<style>
    .log-table {
        table-layout: fixed;
        width: 100%;
    }
    .log-table th, .log-table td {
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
    }
    .log-table pre {
        white-space: pre-wrap;
        word-wrap: break-word;
        word-break: break-all;
        max-height: 300px;
        overflow-y: auto;
        margin-bottom: 0;
        background: #fff;
        padding: 0.5rem;
        border: 1px solid #dee2e6;
        border-radius: 0.25rem;
        font-size: 0.82rem;
    }
    .details-row td {
        padding: 0 !important;
        border-top: none !important;
    }
    .details-content {
        padding: 1rem;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.25rem;
        margin: 0.5rem;
    }
</style>

<h2 class="mb-4">System Logs</h2>
<a class="btn btn-danger mb-3" href="/Admin/SystemLogs/TestException">
    Trigger Test Exception
</a>

<div class="card mb-4">
    <div class="card-header">
        <strong>Filters</strong>
    </div>

    <div class="card-body">
        <form method="get" class="row g-3">

            <div class="col-md-3">
                <label class="form-label">Severity</label>
                <select class="form-select" asp-for="Level">
                    <option value="">All</option>
                    <option>Information</option>
                    <option>Warning</option>
                    <option>Error</option>
                    <option>Critical</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Event Type</label>
                <select class="form-select" asp-for="EventType">
                    <option value="">All</option>
                    <option>Exception</option>
                    <option>SuccessfulLogin</option>
                    <option>FailedLogin</option>
                    <option>UserRegistration</option>
                    <option>SchoolAccountApproval</option>
                    <option>SchoolAccountDenial</option>
                    <option>UserProfileChange</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Search (Message, User ID, Page, Additional Data)</label>
                <input class="form-control" asp-for="SearchTerm" placeholder="Enter search term..." />
            </div>

            <div class="col-md-3">
                <label class="form-label">Start Date</label>
                <input type="date" class="form-control" asp-for="StartDate" />
            </div>

            <div class="col-md-3">
                <label class="form-label">End Date</label>
                <input type="date" class="form-control" asp-for="EndDate" />
            </div>

            <div class="col-md-12">
                <button class="btn btn-primary mt-2">Apply Filters</button>
                <a href="/Admin/SystemLogs/Index" class="btn btn-secondary mt-2">Clear</a>
            </div>

        </form>
    </div>
</div>

<!-- Result count -->
<p class="text-muted mb-2">
    Showing page @Model.CurrentPage of @Model.TotalPages
    (@Model.TotalCount total logs)
</p>

<div style="overflow-x: auto;">
    <table class="table table-striped table-hover log-table">
        <colgroup>
            <col style="width: 20%;" />  @* Timestamp *@
            <col style="width: 9%;" />   @* Level *@
            <col style="width: 15%;" />  @* Event Type *@
            <col style="width: 10%;" />  @* User *@
            <col style="width: 10%;" />  @* Target User *@
            <col style="width: 28%;" />  @* Message *@
            <col style="width: 8%;" />   @* Button *@
        </colgroup>
        <thead>
            <tr>
                <th>Timestamp (ET)</th>
                <th>Level</th>
                <th>Event Type</th>
                <th>User</th>
                <th>Target User</th>
                <th>Message</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var log in Model.Logs)
            {
                <tr>
                    <td style="white-space: nowrap;">@Model.ToEasternTime(log.Timestamp)</td>

                    <td>
                        <span class="badge bg-@GetBadgeColor(log.Level)">
                            @log.Level
                        </span>
                    </td>

                    <td>
                        <span class="badge bg-secondary">@log.EventType</span>
                    </td>

                    <td style="font-size: 0.85em; word-break: break-all;">
                        @if (!string.IsNullOrEmpty(log.UserId))
                        {
                            <span title="@log.UserId">@log.UserId.Substring(0, Math.Min(8, log.UserId.Length))...</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>

                    <td style="font-size: 0.85em; word-break: break-all;">
                        @if (!string.IsNullOrEmpty(log.TargetUserId))
                        {
                            <span title="@log.TargetUserId">@log.TargetUserId.Substring(0, Math.Min(8, log.TargetUserId.Length))...</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>

                    <td style="word-wrap: break-word;">
                        @log.Message
                    </td>

                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#details-@log.LogId">
                            Details
                        </button>
                    </td>
                </tr>
                <tr class="details-row collapse" id="details-@log.LogId">
                    <td colspan="7">
                        <div class="details-content">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Full User ID:</strong>
                                    <pre>@(log.UserId ?? "(none)")</pre>
                                </div>
                                <div class="col-md-6">
                                    <strong>Full Target User ID:</strong>
                                    <pre>@(log.TargetUserId ?? "(none)")</pre>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-6">
                                    <strong>Page:</strong>
                                    <pre>@(log.Page ?? "(none)")</pre>
                                </div>
                                <div class="col-md-6">
                                    <strong>Additional Data:</strong>
                                    <pre>@(log.AdditionalData ?? "(none)")</pre>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(log.StackTrace))
                            {
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <strong>Stack Trace:</strong>
                                        <pre>@log.StackTrace</pre>
                                    </div>
                                </div>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" 
                       asp-page="/Admin/SystemLogs/Index"
                       asp-route-currentPage="@(Model.CurrentPage - 1)"
                       asp-route-level="@Model.Level"
                       asp-route-eventType="@Model.EventType"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-startDate="@Model.StartDate"
                       asp-route-endDate="@Model.EndDate">
                        Previous
                    </a>
                </li>
            }

            @{
                var startPage = Math.Max(1, Model.CurrentPage - 2);
                var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
            }

            @for (var i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-page="/Admin/SystemLogs/Index"
                       asp-route-currentPage="@i"
                       asp-route-level="@Model.Level"
                       asp-route-eventType="@Model.EventType"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-startDate="@Model.StartDate"
                       asp-route-endDate="@Model.EndDate">
                        @i
                    </a>
                </li>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-page="/Admin/SystemLogs/Index"
                       asp-route-currentPage="@(Model.CurrentPage + 1)"
                       asp-route-level="@Model.Level"
                       asp-route-eventType="@Model.EventType"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-startDate="@Model.StartDate"
                       asp-route-endDate="@Model.EndDate">
                        Next
                    </a>
                </li>
            }
        </ul>
    </nav>
}

@functions {
    string GetBadgeColor(string level)
    {
        return level switch
        {
            "Information" => "info",
            "Warning" => "warning",
            "Error" => "danger",
            "Critical" => "dark",
            _ => "secondary"
        };
    }
}
