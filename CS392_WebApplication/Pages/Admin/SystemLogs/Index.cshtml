@page
@model CS392_WebApplication.Pages.Admin.SystemLogs.IndexModel
@{
    ViewData["Title"] = "System Logs";
}

<style>
    .log-table {
        table-layout: fixed;
        width: 100%;
    }
    .log-table th, .log-table td {
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
    }
    .log-table pre {
        white-space: pre-wrap;
        word-wrap: break-word;
        word-break: break-all;
        max-height: 300px;
        overflow-y: auto;
        margin-bottom: 0;
        background: #fff;
        padding: 0.5rem;
        border: 1px solid #dee2e6;
        border-radius: 0.25rem;
        font-size: 0.82rem;
    }
    .details-row td {
        padding: 0 !important;
        border-top: none !important;
    }
    .details-content {
        padding: 1rem;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.25rem;
        margin: 0.5rem;
    }
</style>

<h2 class="mb-4">System Logs</h2>
<a class="btn btn-danger mb-3" href="/Admin/SystemLogs/TestException">
    Trigger Test Exception
</a>

<div class="card mb-4">
    <div class="card-header">
        <strong>Filters</strong>
    </div>

    <div class="card-body">
        <form method="get" class="row g-3">

            <div class="col-md-3">
                <label class="form-label">Severity</label>
                <select class="form-select" asp-for="Level">
                    <option value="">All</option>
                    <option>Information</option>
                    <option>Warning</option>
                    <option>Error</option>
                    <option>Critical</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Event Type</label>
                <select class="form-select" asp-for="EventType">
                    <option value="">All</option>
                    <option>Exception</option>
                    <option>FailedLogin</option>
                    <option>RoleChange</option>
                    <option>AccountChange</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">User ID</label>
                <input class="form-control" asp-for="UserId" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Target User ID</label>
                <input class="form-control" asp-for="TargetUserId" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Page</label>
                <input class="form-control" asp-for="PageFilter" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Start Date</label>
                <input type="date" class="form-control" asp-for="StartDate" />
            </div>

            <div class="col-md-3">
                <label class="form-label">End Date</label>
                <input type="date" class="form-control" asp-for="EndDate" />
            </div>

            <div class="col-md-12">
                <button class="btn btn-primary mt-2">Apply Filters</button>
                <a href="/Admin/SystemLogs/Index" class="btn btn-secondary mt-2">Clear</a>
            </div>

        </form>
    </div>
</div>

<!-- Result count -->
<p class="text-muted mb-2">
    Showing page @Model.CurrentPage of @Model.TotalPages
    (@Model.TotalCount total logs)
</p>

<div style="overflow-x: auto;">
    <table class="table table-striped table-hover log-table">
        <colgroup>
            <col style="width: 20%;" />  @* Timestamp *@
            <col style="width: 9%;" />   @* Level *@
            <col style="width: 11%;" />  @* Event Type *@
            <col style="width: 10%;" />  @* User *@
            <col style="width: 10%;" />  @* Target User *@
            <col style="width: 32%;" />  @* Message *@
            <col style="width: 8%;" />   @* Button *@
        </colgroup>
        <thead>
            <tr>
                <th>Timestamp (ET)</th>
                <th>Level</th>
                <th>Event Type</th>
                <th>User</th>
                <th>Target User</th>
                <th>Message</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var log in Model.Logs)
            {
                <tr>
                    <td style="white-space: nowrap;">@Model.ToEasternTime(log.Timestamp)</td>

                    <td>
                        <span class="badge bg-@GetBadgeColor(log.Level)">
                            @log.Level
                        </span>
                    </td>

                    <td>@log.EventType</td>
                    <td class="text-truncate">@log.UserId</td>
                    <td class="text-truncate">@log.TargetUserId</td>
                    <td class="text-truncate">@log.Message</td>

                    <td>
                        <button class="btn btn-sm btn-outline-info"
                                type="button"
                                onclick="toggleDetails('details-@log.LogId', this)">
                            Details
                        </button>
                    </td>
                </tr>

                <tr id="details-@log.LogId" class="details-row" style="display: none;">
                    <td colspan="7">
                        <div class="details-content">
                            <strong>Page:</strong> @log.Page <br />

                            <strong>Additional Data:</strong>
                            <pre>@log.AdditionalData</pre>

                            @if (!string.IsNullOrEmpty(log.StackTrace))
                            {
                                <strong>Stack Trace:</strong>
                                <pre>@log.StackTrace</pre>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Log pagination">
        <ul class="pagination justify-content-center">
            <!-- Previous -->
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-page="/Admin/SystemLogs/Index"
                   asp-route-currentPage="@(Model.CurrentPage - 1)"
                   asp-route-level="@Model.Level"
                   asp-route-eventType="@Model.EventType"
                   asp-route-userId="@Model.UserId"
                   asp-route-targetUserId="@Model.TargetUserId"
                   asp-route-pageFilter="@Model.PageFilter"
                   asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                   asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")">
                    &laquo; Previous
                </a>
            </li>

            @{
                int startPage = Math.Max(1, Model.CurrentPage - 2);
                int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
            }

            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-page="/Admin/SystemLogs/Index"
                       asp-route-currentPage="1"
                       asp-route-level="@Model.Level"
                       asp-route-eventType="@Model.EventType"
                       asp-route-userId="@Model.UserId"
                       asp-route-targetUserId="@Model.TargetUserId"
                       asp-route-pageFilter="@Model.PageFilter"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")">1</a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-page="/Admin/SystemLogs/Index"
                       asp-route-currentPage="@i"
                       asp-route-level="@Model.Level"
                       asp-route-eventType="@Model.EventType"
                       asp-route-userId="@Model.UserId"
                       asp-route-targetUserId="@Model.TargetUserId"
                       asp-route-pageFilter="@Model.PageFilter"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")">@i</a>
                </li>
            }

            @if (endPage < Model.TotalPages)
            {
                @if (endPage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                <li class="page-item">
                    <a class="page-link"
                       asp-page="/Admin/SystemLogs/Index"
                       asp-route-currentPage="@Model.TotalPages"
                       asp-route-level="@Model.Level"
                       asp-route-eventType="@Model.EventType"
                       asp-route-userId="@Model.UserId"
                       asp-route-targetUserId="@Model.TargetUserId"
                       asp-route-pageFilter="@Model.PageFilter"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")">@Model.TotalPages</a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-page="/Admin/SystemLogs/Index"
                   asp-route-currentPage="@(Model.CurrentPage + 1)"
                   asp-route-level="@Model.Level"
                   asp-route-eventType="@Model.EventType"
                   asp-route-userId="@Model.UserId"
                   asp-route-targetUserId="@Model.TargetUserId"
                   asp-route-pageFilter="@Model.PageFilter"
                   asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                   asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")">
                    Next &raquo;
                </a>
            </li>
        </ul>
    </nav>
}

<script>
    function toggleDetails(id, btn) {
        var row = document.getElementById(id);
        if (row) {
            var isHidden = row.style.display === 'none';
            row.style.display = isHidden ? '' : 'none';
            btn.textContent = isHidden ? 'Hide' : 'Details';
        }
    }
</script>

@functions {
    string GetBadgeColor(string level)
    {
        return level switch
        {
            "Information" => "primary",
            "Warning" => "warning",
            "Error" => "danger",
            "Critical" => "dark",
            _ => "secondary"
        };
    }
}
