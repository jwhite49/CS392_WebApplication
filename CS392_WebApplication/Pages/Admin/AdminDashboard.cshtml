@page
@model CS392_WebApplication.Pages.Admin.AdminDashboardModel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .dashboard-container {
            max-width: 1000px;
            margin: 40px auto;
            padding: 20px;
            background-color: #f9f9f9;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .dashboard-card {
            background-color: white;
            padding: 20px;
            border-radius: 6px;
            box-shadow: 0 0 5px rgba(0,0,0,0.05);
            text-align: center;
        }

            .dashboard-card h3 {
                margin-bottom: 10px;
            }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <div class="dashboard-header">
            <h1>Welcome, Admin</h1>
            <p>Manage users and system reports</p>
        </div>

        <div class="dashboard-grid">
            <div class="dashboard-card">
                <h3>User Management</h3>
                <p>Create, edit, or delete users</p>
                <a href="/UserPages/Index">Go to Users</a>
            </div>
            <div class="dashboard-card">
                <h3>School User Management</h3>
                <p>Create, edit, or delete school users</p>
               
            </div>
            <div class="dashboard-card">
                <h3>Products</h3>
                <p>Create, edit, or delete products.</p>
                <a href="/ProductPages/Index">Go to Products</a>
            </div>
            <div class="dashboard-card">
                <h3>User Product Lists</h3>
                <p>Create, edit, or delete User's product lists.</p>
                <a href="/Product_List_Pages/Index">Go to User Lists</a>
            </div>
        </div>
    </div>
</body>
</html>